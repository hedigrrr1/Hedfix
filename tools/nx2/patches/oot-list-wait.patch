+// EDEN_NX2_LIST_WAIT_SKIP=0/1 (on by default in Ocarina of Time): before each command list entry
+// the front waited for the compute and copy work queued on the split's back, in case it rewrote
+// the entry (~8,400 waits a second in Kokiri Forest, a fifth of the front's time). Command memory
+// the CPU writes is reused entry after entry: once an entry on a page was read after that wait and
+// the page was not GPU-written, later entries on it skip the wait. Pages the GPU writes are told
+// apart by IsGpuWrittenCommands before it, as before.
+bool DmaPusher::SkipsListWait() const {
+    static const int forced = [] {
+        const char* value = std::getenv("EDEN_NX2_LIST_WAIT_SKIP");
+        return value == nullptr ? -1 : value[0] == '1' ? 1 : 0;
+    }();
+    if (forced != -1) {
+        return forced == 1;
+    }
+    static const bool ocarina = system.GetApplicationProcessProgramID() == 0x0400486024DEC000ULL;
+    return ocarina;
+}
+
+bool DmaPusher::IsCpuListMemory(GPUVAddr address, size_t size) {
+    if (size == 0) {
+        return false;
+    }
+    for (GPUVAddr page = address & ~GPUVAddr{0xfff}; page < address + size; page += 0x1000) {
+        const auto device = memory_manager.GpuToCpuAddress(page);
+        if (!device) {
+            return false;
+        }
+        const u64 index = *device >> Tegra::Nx2WrittenPageBits;
+        if (index >= Tegra::g_nx2_cpu_list_pages.size() * 64 ||
+            ((Tegra::g_nx2_cpu_list_pages[index / 64].load(std::memory_order_relaxed) >>
+              (index % 64)) & 1) == 0 ||
+            Tegra::Nx2IsGpuWritten(*device)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+void DmaPusher::MarkCpuListMemory(GPUVAddr address, size_t size) {
+    for (GPUVAddr page = address & ~GPUVAddr{0xfff}; page < address + size; page += 0x1000) {
+        const auto device = memory_manager.GpuToCpuAddress(page);
+        if (!device || Tegra::Nx2IsGpuWritten(*device)) {
+            continue;
+        }
+        const u64 index = *device >> Tegra::Nx2WrittenPageBits;
+        if (index < Tegra::g_nx2_cpu_list_pages.size() * 64) {
+            Tegra::g_nx2_cpu_list_pages[index / 64].fetch_or(u64{1} << (index % 64),
+                                                             std::memory_order_relaxed);
+        }
+    }
+}
