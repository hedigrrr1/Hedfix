+namespace {
+// EDEN_NX2_TRACE_DST=<hex>: also log draws and depth clears whose depth target lies within 32 MiB
+// above that GPU address, as the DMA and 2D engines do for their copies.
+void TraceDepthTarget(const Tegra::Engines::Maxwell3D& maxwell3d, const char* what, bool active) {
+    static const u64 destination = [] {
+        const char* value = std::getenv("EDEN_NX2_TRACE_DST");
+        return value != nullptr ? std::strtoull(value, nullptr, 16) : 0ULL;
+    }();
+    const auto& regs = maxwell3d.regs;
+    if (destination == 0 || !active) {
+        return;
+    }
+    const GPUVAddr zeta = regs.zeta.Address();
+    if (zeta < destination || zeta >= destination + (32ULL << 20)) {
+        return;
+    }
+    const u64 vs = (u64{regs.pipelines[1].reserved[0] & 0xff} << 32) | regs.pipelines[1].reserved[1];
+    const u64 ps = (u64{regs.pipelines[5].reserved[0] & 0xff} << 32) | regs.pipelines[5].reserved[1];
+    // Once per writer: a target is drawn every frame.
+    static std::set<std::tuple<std::string_view, GPUVAddr, u64, u64, u32>> seen;
+    if (seen.size() >= 512 ||
+        !seen.emplace(what, zeta, vs, ps, regs.depth_write_enabled).second) {
+        return;
+    }
+    LOG_INFO(HW_GPU,
+             "nx2 {} to traced depth: {:#x} format={:#x} {}x{} write={} test={} func={} vs={:#x} "
+             "ps={:#x} rt0={:#x} clear_depth={}",
+             what, zeta, static_cast<u32>(regs.zeta.format), regs.zeta_size.width,
+             regs.zeta_size.height, regs.depth_write_enabled, regs.depth_test_enable,
+             static_cast<u32>(regs.depth_test_func), vs, ps, regs.rt[0].Address(), regs.clear_depth);
+}
