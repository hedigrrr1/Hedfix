 namespace Kernel {
 
+namespace {
+// EDEN_NX2_SCHED_TRACE=<ms>: log every guest thread that waits longer than that between becoming
+// runnable and running, with the thread its core was running when it became runnable.
+struct LateRunTracer {
+    struct Pending {
+        std::chrono::steady_clock::time_point since;
+        u64 blocker_id;
+        s32 blocker_priority;
+        s32 core;
+    };
+
+    static LateRunTracer& Get() {
+        static LateRunTracer tracer;
+        return tracer;
+    }
+
+    const std::chrono::microseconds threshold{[] {
+        const char* text = std::getenv("EDEN_NX2_SCHED_TRACE");
+        return text ? static_cast<long long>(std::strtod(text, nullptr) * 1000.0) : 0LL;
+    }()};
+    std::mutex mutex;
+    std::unordered_map<const KThread*, Pending> pending;
+
+    bool Enabled() const {
+        return threshold.count() > 0;
+    }
+
+    void OnRunnable(KernelCore& kernel, const KThread* thread) {
+        const s32 core = thread->GetActiveCore();
+        u64 blocker_id = 0;
+        s32 blocker_priority = -1;
+        if (core >= 0 && core < static_cast<s32>(Core::Hardware::NUM_CPU_CORES)) {
+            const auto& scheduler = kernel.Scheduler(core);
+            const KThread* running = scheduler.GetSchedulerCurrentThread();
+            if (running != nullptr && running != scheduler.GetIdleThread()) {
+                blocker_id = running->GetThreadId();
+                blocker_priority = running->GetPriority();
+            }
+        }
+        std::scoped_lock lk{mutex};
+        pending[thread] = {std::chrono::steady_clock::now(), blocker_id, blocker_priority, core};
+    }
+
+    void OnNotRunnable(const KThread* thread) {
+        std::scoped_lock lk{mutex};
+        pending.erase(thread);
+    }
+
+    void OnRun(const KThread* thread, const KThread* previous, s32 core) {
+        Pending entry{};
+        {
+            std::scoped_lock lk{mutex};
+            const auto it = pending.find(thread);
+            if (it == pending.end()) {
+                return;
+            }
+            entry = it->second;
+            pending.erase(it);
+        }
+        const auto waited = std::chrono::steady_clock::now() - entry.since;
+        if (waited < threshold) {
+            return;
+        }
+        LOG_INFO(Kernel, "late run: thread={} prio={} affinity={:#x} core={} waited={:.2f}ms "
+                         "running_at_wake={}/{} on core {} previous={}/{}",
+                 thread->GetThreadId(), thread->GetPriority(),
+                 thread->GetAffinityMask().GetAffinityMask(), core,
+                 std::chrono::duration<double, std::milli>(waited).count(), entry.blocker_id,
+                 entry.blocker_priority, entry.core, previous ? previous->GetThreadId() : 0,
+                 previous ? previous->GetPriority() : -1);
+    }
+};
+} // namespace
